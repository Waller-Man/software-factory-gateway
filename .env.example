# Copy this file to .env next to package.json, then fill locally.
# Values are read only by the DSH backend. Never distribute your .env.
HUGEGRAPH_BASE_URL=http://127.0.0.1:18080
HUGEGRAPH_GRAPHSPACE=DEFAULT
HUGEGRAPH_GRAPH=hugegraph
HUGEGRAPH_USERNAME=
HUGEGRAPH_PASSWORD=
# Quote values containing # or leading/trailing spaces, e.g. 'local#value'.
# No variable expansion or shell commands. Double quotes support \" and \\.
